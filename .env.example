# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: NEVER expose to the browser. Used only in server-side
# API routes (e.g. the endpoint called by the ChatGPT Action) to bypass RLS
# after validating the caller's per-user API key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI Responses API, usata dalla chat AI interna alla dashboard.
# La chiave resta esclusivamente lato server.
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5-mini

# Segreto del cron giornaliero di rivalutazione (/api/cron/revalue).
# Vercel lo invia come "Authorization: Bearer $CRON_SECRET". Genera un valore
# casuale, ad esempio con: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Opzionale: annunci eBay (Browse API) come seconda fonte per gli zashi RAW
# che West Blue non traccia. Keyset "Production" da developer.ebay.com
# (App ID = client id, Cert ID = client secret). Senza, il fallback è spento.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
