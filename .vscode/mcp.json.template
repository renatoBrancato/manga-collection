{
  "servers": {
    "manga-collection": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${input:manga_api_key}"
      }
    }
  },
  "inputs": [
    {
      "id": "manga_api_key",
      "type": "promptString",
      "description": "API key personale (pagina /settings della web app, dopo il login)",
      "password": true
    }
  ]
}
